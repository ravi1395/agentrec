import { Request, Response, NextFunction } from "express";
import { getUser, verifyPassword } from "./users";
import { createSession } from "./session";

// Sliding-window login rate limiter, keyed by IP + email.
// Resets automatically once a window elapses; no external store needed
// at this scale. Revisit if we ever run more than one API instance.
//

const MAX_ATTEMPTS = 5;
const WINDOW_MS = 15 * 60 * 1000;

interface LoginAttempt {
  count: number;
  windowStart: number;
}

const attempts = new Map<string, LoginAttempt>();

function keyFor(req: Request): string {
  return `${req.ip}:${req.body.email ?? "unknown"}`;
}

function pruneStale(entry: LoginAttempt, now: number): LoginAttempt {
  if (now - entry.windowStart > WINDOW_MS) {
    return { count: 0, windowStart: now };
  }
  return entry;
}

export async function login(req: Request, res: Response, next: NextFunction) {
  const { email, password } = req.body;
  if (!email || !password) {
    return res.status(400).json({ error: "email and password required" });
  }

  const now = Date.now();
  const key = keyFor(req);
  const raw = attempts.get(key) ?? { count: 0, windowStart: now };
  const entry = pruneStale(raw, now);

  if (entry.count >= MAX_ATTEMPTS) {
    return res.status(429).json({
      error: "too many login attempts, try again later",
    });
  }

  const user = await getUser(email);
  if (!user || !(await verifyPassword(user, password))) {
    entry.count += 1;
    attempts.set(key, entry);
    return res.status(401).json({ error: "invalid credentials" });
  }

  attempts.delete(key);
  const session = await createSession(user);
  res.cookie("session", session.token, { httpOnly: true, secure: true });
  return res.json({ user: { id: user.id, email: user.email } });
}

export function requireAuth(req: Request, res: Response, next: NextFunction) {
  if (!req.cookies?.session) {
    return res.status(401).json({ error: "not authenticated" });
  }
  next();
}
